rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // An owner is any signed-in account with a document at owners/{uid}.
    // Create that document by hand in the Firebase console (see SETUP.md).
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    match /owners/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // An owner may only add or remove their own push-notification tokens.
      allow update: if isOwner() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens']);
      allow create, delete: if false;
    }

    // Price list, slots, studio location, UPI details. Everyone reads, only owners change.
    match /config/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Booked time slots per day: { taken: ["10:00", ...] }. No customer details here.
    match /slots/{date} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Owner phone tokens for push notifications live on owners/{uid} (fcmTokens array),
    // written by the owner app. Cloud Functions read them with admin access.

    // Payment history. Written by the owner app when an advance or balance is confirmed.
    match /payments/{paymentId} {
      allow read, write: if isOwner();
    }

    // One chat per booking: chats/{bookingId} holds the summary, messages live underneath.
    match /chats/{bookingId} {
      function bookingOwnerUid() {
        return get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerUid;
      }
      function isClient() { return signedIn() && bookingOwnerUid() == request.auth.uid; }

      allow read: if isOwner() || isClient();
      allow create: if isOwner() || (isClient() && request.resource.data.customerUid == request.auth.uid);
      allow update: if isOwner() || (
        isClient()
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'lastText', 'lastFrom', 'lastAt', 'ownerUnread', 'customerUnread'])
      );

      match /messages/{messageId} {
        allow read: if isOwner() || isClient();
        allow create: if (
            (isOwner() && request.resource.data.from == 'owner')
            || (isClient() && request.resource.data.from == 'customer')
          )
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (!('mediaUrl' in request.resource.data) || request.resource.data.mediaType in ['image', 'video']);
        allow update, delete: if isOwner();
      }
    }

    match /bookings/{bookingId} {
      function mine() { return signedIn() && resource.data.customerUid == request.auth.uid; }

      allow read: if isOwner() || mine();

      // Customers can only create their own booking, always starting as "requested".
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.inspoUrls is list && request.resource.data.inspoUrls.size() >= 1
        && request.resource.data.inspoUrls.size() <= 10
        && request.resource.data.naturalUrls.size() <= 5;

      // After approval the customer may only add their UPI reference.
      allow update: if isOwner() || (
        mine()
        && resource.data.status == 'approved'
        && request.resource.data.status == 'payment_submitted'
        && request.resource.data.paymentRef is string && request.resource.data.paymentRef.size() <= 40
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'paymentRef', 'paymentSubmittedAt', 'updatedAt'])
      );

      allow delete: if isOwner();
    }
  }
}
